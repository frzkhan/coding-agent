PROVIDER=ollama
OPENAI_API_KEY=your_api_key_here
MODEL=qwen3:latest
TEMPERATURE=0.2
MAX_STEPS=8
CONTEXT_TOKEN_LIMIT=24000
# Prefix-allowlist for the shell tool; add commands the agent may run for verify/tests (e.g. npm test, npx tsc).
SHELL_ALLOWLIST=ls,pwd,rg,npm test,npx tsc,ruff,go,mypy
SHELL_TIMEOUT_MS=12000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set to false to silence AI SDK provider warnings (e.g. Ollama + generateObject).
AI_SDK_LOG_WARNINGS=false
