PROVIDER=ollama
OPENAI_API_KEY=your_api_key_here
MODEL=qwen3:latest
TEMPERATURE=0.2
MAX_STEPS=8
CONTEXT_TOKEN_LIMIT=24000
SHELL_ALLOWLIST=ls,pwd,rg,npm test,npx tsc,ruff,go,mypy
# After each successful writeFile/str_replace: run from workspace root. Match SHELL_ALLOWLIST prefix.
# This repo is TypeScript; uncomment to auto-run the same check you use in CI:
POST_EDIT_VERIFY=npx tsc --noEmit --incremental
# Other projects: e.g. POST_EDIT_VERIFY=ruff check .  or  go test ./...
SHELL_TIMEOUT_MS=12000
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_SDK_LOG_WARNINGS=false
